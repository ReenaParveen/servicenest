NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/servicenest
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-random-string-at-least-32-characters
JWT_EXPIRES_IN=12h
PLATFORM_NAME=ServiceNest
SEED_DEMO_PASSWORD=DemoPass123!
ENABLE_REMINDER_JOB=true
TRUST_PROXY=false

# First administrator. Used only by: npm run create-admin
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Optional email notifications. In-app notifications work without SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ServiceNest <noreply@localhost>"

# Optional Razorpay test-mode keys. Leave blank to use the development payment simulator.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional. OpenStreetMap Nominatim is used when this is empty.
# When set, geocoding uses Google and map tiles stay on OpenStreetMap.
GOOGLE_MAPS_API_KEY=
